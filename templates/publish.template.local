# Where setup/publish.sh publishes, and under whose name.
# Sourced as shell. Never exported. Uncomment and fill in to enable publishing;
# while AIOS_PUBLIC_REMOTE is unset, publish.sh refuses to run and says so.

# AIOS_PUBLIC_REMOTE=https://github.com/<you>/<repo>.git

# Identity stamped on PUBLIC commits. Deliberately NOT your ~/.gitconfig address:
# commit metadata is not file content, so the leak check cannot see it, and it
# cannot be scrubbed once pushed. The users.noreply form still links commits to
# your GitHub account.
# AIOS_PUBLIC_GIT_NAME="Your Name"
# AIOS_PUBLIC_GIT_EMAIL=<you>@users.noreply.github.com

# Repo metadata, applied after a successful push to the default branch. Topics
# are a REPLACE, so this list is the single source of truth -- removing one here
# removes it on GitHub. Needs a gh login with Administration write; without it
# the sync is skipped with a note rather than failing the publish.
# AIOS_PUBLIC_TOPICS="obsidian claude-code pkm second-brain"
# AIOS_PUBLIC_DESCRIPTION="One line describing your fork"
